# Local PostgreSQL
DATABASE_URL=postgresql://foodiary:foodiary_dev@127.0.0.1:5434/foodiary
AUTH_JWT_SECRET=
LOCAL_MEALS_DIR=./data/meals
LOCAL_PROFILE_PHOTOS_DIR=./data/profile-photos

# Cognito
COGNITO_EMAILS_FROM=noreply@foodiary.com.br
COGNITO_EMAILS_REPLY_TO=suporte@foodiary.com.br

# SES
SES_ARN=

# Route 53
ROUTE53_HOSTED_ZONE_ID=

# API Gateway Custom Domain
DISABLE_DEFAULT_APIGW_ENDPOINT=false
API_DOMAIN_NAME=

# Meals CDN Custom Domain
MEALS_CDN_DOMAIN_NAME=
MEALS_CDN_CERTIFICATE_ARN=

# External services
OPENAI_API_KEY=
